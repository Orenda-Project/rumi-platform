# Dependencies
node_modules/
.pnp
.pnp.js
bun.lockb

# Environment variables - NEVER commit these
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.staging
# Timestamped copies the operator console takes before it writes .env. Each one
# holds every credential the deployment has, so they must never be committable —
# a bare `.env` rule does not match `.env.bak.2026-01-01T00-00-00-000Z`.
.env.bak.*

# Internal working notes. docs/internal/api-consolidation.md already states in
# its own header that this directory is not committed — but no rule existed, so
# the whole directory was one `git add .` away from a public repo.
docs/internal/

# Secrets and credentials
keys/
*.pem
*.key
*.cert
*.p12

# Messaging channel local state (e.g. .channel-state/baileys/ session auth) —
# grants live account access, treat like a credential. See CHANNEL_STATE_DIR
# in .env.template.
.channel-state/
credentials*
service-account*.json
.railway-token

# Setup state (generated during /setup)
.setup-state.json

