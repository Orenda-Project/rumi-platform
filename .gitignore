# Dependencies
node_modules/
.pnp
.pnp.js
bun.lockb

# Environment variables - NEVER commit these
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.staging

# Secrets and credentials
keys/
*.pem
*.key
*.cert
*.p12

# Messaging channel local state (e.g. .channel-state/baileys/ session auth) —
# grants live account access, treat like a credential. See CHANNEL_STATE_DIR
# in .env.template.
.channel-state/
credentials*
service-account*.json
.railway-token

# Matrix channel local state (sync token store + E2EE crypto store), see
# MATRIX_STORAGE_DIR in .env.template. Same "treat like a credential"
# reasoning as .channel-state/ above: the crypto store holds Megolm/Olm keys.
.matrix-storage/

# Setup state (generated during /setup)
.setup-state.json

# Temporary files
temp/
tmp/
*.tmp
*.zip

