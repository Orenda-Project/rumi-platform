# Dedicated quiz queue (Standard SQS, which honours per-message DelaySeconds).
# Needed by the lesson quiz (TRANSCRIPT_QUIZ_ENABLED=true) and by every
# delayed quiz job: quiz_offer (+240 s), quiz_nudge_teacher, quiz_video_report,
# quiz_report/quiz_expire/quiz_nudge/quiz_reminder. If unset, quiz jobs go to
# SQS_QUEUE_URL. That queue is FIFO and drops the delay, so they run AT ONCE:
# the lesson-quiz offer arrives right after the report, and a teacher nudge
# whose time has not come is dropped (logged as a WARN). The interactive
# quiz loop (deliver + answer) works either way. With QUEUE_DRIVER=bullmq no
# extra queue is needed (BullMQ honours delays).
SQS_QUIZ_QUEUE_URL=
SQS_WORKER_CONCURRENCY=3
SQS_WORKER_HEALTH_PORT=3004
SQS_POLL_INTERVAL=20

# --- Optional: Worker Mode ---------------------------------------------------
# Set to 'worker' when running as a dedicated worker process

WORKER_MODE=

# --- Optional: WhatsApp 2FA ---------------------------------------------------
# Two-step verification PIN for WhatsApp phone number

WHATSAPP_2FA_PIN=

# --- Optional: GPT Cache -----------------------------------------------------
# Cache TTL for LLM responses (in seconds)

GPT_CACHE_TTL=

# --- Optional: GitHub Branch --------------------------------------------------
# Default branch for bot repo (for deployment scripts)

GITHUB_BRANCH_BOT=main

# --- ENABLES: Video generation (Kie.ai) --------------------------------------
# Kie.ai (Nano Banana Pro) generates the visuals for the video feature. Pair
# with VIDEO_GENERATION_ENABLED=true above and a TTS key for narration.
KIE_API_KEY=

# --- ENABLES: Pic-to-LP (photo → illustrated lesson plan) --------------------
# A teacher photographs a textbook page and Rumi generates a 2-page illustrated
# lesson-plan PDF via Kie.ai image generation. Requires KIE_API_KEY (above);
# leave the keys below blank to use defaults / skip the optional pieces.
#
# Optional dedicated Kie.ai key for pic-to-LP (rate-limit isolation from the
# video feature). Falls back to KIE_API_KEY when unset.
KIE_API_KEY_PIC_LP=
# WhatsApp Flow ID for the pic-to-LP confirmation form. Leave blank to fall
# back to a plain-text confirmation message instead of the Flow.
PIC_LP_FLOW_ID=
# Optional teacher-facing WhatsApp number shown in the lesson-plan Coaching
# Corner ("WhatsApp Rumi · <number>"). Leave blank to omit the contact line.
COACHING_WHATSAPP_NUMBER=
# Optional R2 object key for the brand-mark logo rendered in the LP header
# (defaults to brand/rumi-white-smile-v1.png when unset).
RUMI_LOGO_R2_KEY=
# Optional model overrides (default to gpt-4o-mini when unset).
PIC_LP_CLASSIFIER_MODEL=
PIC_LP_EXTRACTOR_MODEL=
# Optional debug overrides to force a specific image backend ('true' to enable).
PIC_LP_FORCE_GAMMA=
PIC_LP_FORCE_KIEAI=

# --- Optional: Phone Number ---------------------------------------------------
# Bot's phone number in international format (without +)

PHONE_NUMBER=

# --- Optional: Reading Assessment Config --------------------------------------

USE_PASSAGE_BACKGROUNDS=true

# Benchmark thresholds (WCPM/LCPM) come from bot/shared/config/reading-benchmarks.js
# (the in-app source of truth). Set this to 1 ONLY to route benchmark comparison
# back through the legacy SQL RPCs (check_benchmark_status /
# check_lcpm_benchmark_status) as a fallback. Leave blank/unset for normal use.
READING_BENCHMARKS_USE_RPC=

# --- Optional: PDF rendering (Playwright HTML→PDF) ----------------------------
# Reports (e.g. the reading assessment) render via Playwright + a system
# Chromium for proper Urdu/Nastaliq glyph shaping. playwright-core does NOT
# bundle a browser — install one (e.g. `apt-get install chromium`) and, if it
# is not on a standard path, point to it here. When no Chromium is found the
# report generator automatically falls back to the PDFKit renderer, so these
# are OPTIONAL.
PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=
PUPPETEER_EXECUTABLE_PATH=

# --- Optional: Staging Configuration -----------------------------------------
# For running a separate staging environment

META_APP_ID_STAGING=
STAGING_WABA_ID=
