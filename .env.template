# ============================================================================
# Rumi Platform — Environment Configuration
# ============================================================================
#
# YOU PROBABLY DO NOT NEED TO EDIT THIS BY HAND.
#
#   ./install.sh && rumi setup
#
# fills all of it in for you, asking in plain language, checking each value
# against the real service as you enter it, and creating the database tables.
# Read on only if you would rather do it yourself, or you are on a machine with
# no interactive terminal.
#
# ----------------------------------------------------------------------------
# HOW THIS WORKS (read this first — also true for your AI setup agent):
#
#   1. Copy this file:            cp .env.template .env
#   2. Fill in the REQUIRED block below (4 core values), plus whichever
#      CHANNEL_DRIVER you pick (baileys needs none; meta needs 4 more). That
#      alone boots the bot with AI chat + registration.
#   3. Features turn on by PRESENCE. Set a feature's keys and that feature
#      switches on automatically — there is no master "enable" flag to flip.
#      Leave a feature's keys blank and that feature stays off cleanly (the
#      bot will never crash because a key is missing; it just won't offer
#      that feature). Each optional block below says exactly which keys
#      switch it on. The messaging channel works the same way — see
#      CHANNEL_DRIVER below.
#   4. Verify what you configured:   rumi doctor   (or: npm run doctor)
#      (prints a green/red matrix of every service and which features are live)
#      rumi status also shows whether the bot is running and which WhatsApp
#      number it answers as.
#
# Any value shown as CHANGEME, your-..., or a placeholder URL MUST be replaced.
# Never commit your real .env — only this template is tracked (.env is gitignored).
#
# ============================================================================
# ███  REQUIRED — the bot will not start without these 4 core values  ███████
# ============================================================================

# Node environment: production | development | test
NODE_ENV=production

# HTTP port for the bot server
PORT=3000

# Optional (local dev only): your personal ngrok authtoken, used to expose the local
# webhook to Meta during testing. Get one free at https://dashboard.ngrok.com.
# Leave blank in production (Railway gives you a public URL). NEVER commit a real token.
NGROK_AUTHTOKEN=

# --- Messaging channel — how the bot talks to WhatsApp -----------------------
# baileys (default): sandbox mode — pairs with your own WhatsApp via a QR code,
#   no Meta account needed. Good for trying Rumi out or local development.
#   Pair with: npm run pair:baileys (or: node bot/scripts/setup/baileys-pair.js)
#   Sends/receives text, image, audio, and document messages once paired.
#   WhatsApp Flows, approved templates, and carousels are Meta-only — there is
#   no Baileys equivalent yet, so those log clearly instead of sending.
#   `npm run doctor` reports config readiness, not "messaging works" — pair
#   and send yourself a test message to confirm that end to end.
# meta: WhatsApp Cloud API, for a real deployment — requires the WhatsApp
#   block further down. See docs/onboarding/sandbox-production-design.md.
# none: no WhatsApp at all — teachers reach Rumi only on the channels set up
#   below (your own Matrix messenger, Slack, Discord). See docs/channels/matrix.md.
CHANNEL_DRIVER=baileys

# Where the Baileys sandbox driver stores its local WhatsApp Web session
# (auth keys) — one var, regardless of how many drivers exist. Pair with:
#   node bot/scripts/setup/baileys-pair.js
# Treat this directory like a credential (it grants live account access) —
# it's gitignored (.channel-state/) and must never be committed.
CHANNEL_STATE_DIR=.channel-state

# --- Database (Supabase) — create a free project at https://supabase.com ----

# Your Supabase project URL
SUPABASE_URL=https://your-project.supabase.co

# Your Supabase SERVICE ROLE key (Settings → API → service_role). NOT the anon key.
SUPABASE_SERVICE_ROLE_KEY=CHANGEME-supabase-service-role-key

# --- AI / LLM — one key powers all text generation --------------------------

# Your OpenRouter API key — get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=CHANGEME-sk-or-v1-your-openrouter-key

# --- Redis — job queue + session state --------------------------------------
# Use a managed Redis (Railway/Upstash) in production. Local dev can use the
# default below with a locally running Redis.
REDIS_URL=redis://localhost:6379

# --- WhatsApp — from Meta Business Manager (see docs/whatsapp-setup) ---------
# Required only if CHANNEL_DRIVER=meta above — leave blank for the default
# baileys (sandbox) driver. Fill these manually OR via `npm run setup:flows`
# (which registers Flow assets and prints PHONE_NUMBER_ID / WABA_ID for you on
# first run). Full step-by-step: docs/onboarding/whatsapp.md.

# WhatsApp Cloud API access token (a permanent system-user token)
WHATSAPP_TOKEN=CHANGEME-whatsapp-token

# WhatsApp phone number ID (NOT the phone number itself)
PHONE_NUMBER_ID=CHANGEME-phone-number-id

# Webhook verify token — you invent this; any random string, must match Meta config
WEBHOOK_VERIFY_TOKEN=CHANGEME-pick-any-random-string

# WhatsApp Business Account (WABA) ID
WABA_ID=CHANGEME-waba-id

# ============================================================================
# ███  OPTIONAL — set a block's keys to switch that feature on  █████████████
# ============================================================================

# --- ENABLES: Slack channel — runs ALONGSIDE the driver above, or on its own -
# Not selected via CHANNEL_DRIVER — Slack is additive, works in BOTH sandbox
# and production, and can run at the same time as WhatsApp, or be the only
# channel with CHANNEL_DRIVER=none. Set BOTH vars to turn it on; leave both
# blank and the bot is unaffected.
#
# Setup: create a Slack app at https://api.slack.com/apps, enable
# Interactivity & Event Subscriptions, point both Request URLs at
# https://<your-host>/api/slack/events and https://<your-host>/api/slack/interactions,
# add the chat:write / files:write / reactions:write bot scopes, then install
# the app to your workspace.

# Signing secret (Basic Information -> App Credentials) — verifies every
# request actually came from Slack.
SLACK_SIGNING_SECRET=

# Bot User OAuth Token (OAuth & Permissions), starts with xoxb-
SLACK_BOT_TOKEN=

# --- ENABLES: Discord channel — runs ALONGSIDE the driver above, or alone ---
# Not selected via CHANNEL_DRIVER — Discord is additive, works in BOTH sandbox
# and production, and can run at the same time as WhatsApp and Slack. Set BOTH
# vars to turn it on; leave both blank and the bot is unaffected.
#
# Setup: create an application at https://discord.com/developers/applications,
# add a Bot, enable the "Message Content" privileged intent, generate an
# invite URL (OAuth2 -> URL Generator, scopes: bot + applications.commands),
# add the bot to a server, then run: npm run discord:register-commands
#
# Unlike Slack, there is no Request URL to configure — this bot uses Discord's
# Gateway (a persistent connection), which also delivers slash commands and
# button/select interactions, so no separate signed HTTP endpoint is needed.

# Bot Token (Bot tab -> Reset Token)
DISCORD_BOT_TOKEN=

# Application ID (General Information tab) — used to register slash commands
DISCORD_APPLICATION_ID=

# Optional: a test server's guild id, for guild-scoped slash command
# registration (instant propagation, vs up to ~1hr for global). Only used by
# `npm run discord:register-commands` — leave blank to register globally.
DISCORD_TEST_GUILD_ID=

# --- ENABLES: Matrix channel -- runs ALONGSIDE the driver above, or alone ---
# Not selected via CHANNEL_DRIVER -- Matrix is additive, works in BOTH sandbox
# and production (self-hosted, so there's no third-party review gate at all),
# and can run at the same time as WhatsApp/Slack/Discord. Set BOTH required
# vars to turn it on; leave both blank and the bot is unaffected.
#
# Setup: on your own homeserver (e.g. Synapse), register a bot account, then
# log in via POST /_matrix/client/v3/login to get a long-lived access token
# (or mint one from the homeserver admin API). No Request URL to configure,
# this bot uses a persistent sync connection (matrix-bot-sdk), like Discord's
# Gateway, not a signed HTTP webhook. No homeserver yet? The rumi-messenger
# repo runs one (with a Rumi-branded app) and writes these lines for you.
# Encryption works on Node 22+. Needs REDIS_URL so the worker's sends (lesson
# plans, reports) are relayed through the bot. Full guide:
# docs/channels/matrix.md

# Your homeserver's client-server API URL, e.g. https://matrix.example.org
MATRIX_HOMESERVER_URL=

# The bot account's access token. Set the same value (and the same
# MATRIX_HOMESERVER_URL) on the worker: relayed sends are signed with a key
# derived from it, and the bot drops any it cannot verify.
MATRIX_ACCESS_TOKEN=

# Optional: the bot's own Matrix user id (e.g. @rumi:example.org). If blank,
# it's resolved automatically via whoami on connect. Also used to reconstruct
# the homeserver domain for a teacher's SHORT identity. A teacher registers
# with a phone-number-shaped username -- a leading "+" (Synapse itself
# rejects a purely numeric localpart: "reserved for guest users") followed by
# their number, e.g. "@+15550101234:example.org" -> wire identity
# "mtx:15550101234" (the leading "+" is dropped; downstream code sees the
# bare phone number, same shape as WhatsApp). Only accounts on this, the
# bot's own server, get the short form; everyone else keeps their full id. Setting
# MATRIX_USER_ID explicitly (rather than relying on the whoami fallback)
# avoids a decode failure on a process's very first send before that whoami
# round trip has completed. See bot/shared/services/messaging/matrix-identity.js
# for the varchar(20) column-budget arithmetic behind the "mtx:" short form.
MATRIX_USER_ID=

# Optional: other homeservers whose users may talk to Rumi, comma-separated
# server names exactly as they appear in user ids (e.g.
# "example.org,other.example.org"). The bot's own server is always allowed;
# blank means only it. Invites from anywhere else are declined and their
# messages ignored. Their users always keep their full id as their identity.
MATRIX_ALLOWED_SERVERS=

# Optional: where sync-state/crypto-store files are persisted. Defaults to
# ./.matrix-storage (relative to the bot process's working directory). This
# MUST survive restarts and redeploys (mount a volume on a PaaS): the crypto
# store is paired with the access token's device, and losing it means a new
# token and device.
MATRIX_STORAGE_DIR=

# End-to-end encryption, on by default and fails closed: if matrix-bot-sdk's
# @matrix-org/matrix-sdk-crypto-nodejs native module can't load on this host
# (Node 22+, with a prebuilt binary for this platform), the Matrix channel
# refuses to start and `rumi doctor` says why. Only "off" runs it without
# encryption; anything else (blank, "on", the old "auto") means on.
MATRIX_E2EE=on

# Optional: the room alias new accounts land in via your homeserver's own
# `auto_join_rooms` config (Element Web removed the client-side
# `welcome_user_id` auto-DM feature, so this is now server-side: the bot
# notices a fresh join here and opens a real 1:1 DM with one welcome
# message). Defaults to "#rumi-announcements:<the bot's own server name>",
# only set this if you're using a differently-named announcements room.
MATRIX_WELCOME_ROOM_ALIAS=

# Optional: the longest Rumi shows "is typing…" for one piece of work, in
# seconds. Typing starts when Rumi accepts a message (or the worker starts a
# lesson plan, test paper or quiz for the teacher), is refreshed while the
# work runs, and stops when the reply is sent; this is only the safety cap.
# Defaults to 300 (5 minutes).
MATRIX_TYPING_MAX_SECONDS=

# Optional, script-only: used by `node bot/scripts/matrix-smoke.js` (a manual
# live-roundtrip check, not part of the running bot). The Matrix user id the
# smoke script sends a test message to and waits for a reply from, e.g.
# @teacher:example.org. Leave blank unless you're running that script.
MATRIX_SMOKE_TARGET_USER=

# Optional, script-only: how long (ms) matrix-smoke.js waits for the reply
# before giving up. Defaults to 60000 (60s).
MATRIX_SMOKE_TIMEOUT_MS=

# --- ENABLES: Morning Brief (programme-health briefs every morning) ----------
# Every morning, a short set of charts about yesterday (and a weekly round-up
# on Fridays) is posted to your team on whatever channel you run — a WhatsApp
# group, a Slack channel, a Discord channel. Set BRIEF_RECIPIENTS to turn it
# on, then schedule `node bot/workers/brief.worker.js` once a morning (Railway
# Cron or crontab). `rumi brief` renders one by hand; `rumi brief --send`
# delivers it. Needs python3 with matplotlib for the charts.

# Who receives it — comma-separated targets your channel drivers understand:
# a WhatsApp group JID (…@g.us), slack:channel:C0123ABC, discord:channel:<id>.
BRIEF_RECIPIENTS=
# A READ-ONLY Postgres URL the renderer reads the numbers from; falls back to
# DATABASE_URL when blank.
BRIEF_DATABASE_URL=
# The time zone (IANA name) the brief's "yesterday" and its weekday are judged in.
BRIEF_TZ=UTC
# The users column the breakdown panels group by (school_name, region, ...).
BRIEF_GROUP_BY=school_name
# Narrow the cohort to one region; blank means every registered teacher.
BRIEF_REGION=
# Narrow the cohort to one organization; blank means every registered teacher.
BRIEF_ORGANIZATION=
# Days of the week that get the daily brief (0 = Sunday ... 6 = Saturday).
BRIEF_DAILY_DOWS=1,2,3,4
# The day of the week that gets the weekly round-up instead.
BRIEF_WEEKLY_DOW=5
# Where the renderer writes the panels and manifest (relative to the repo root).
BRIEF_OUT_DIR=brief/out
# The dashboard URL printed under each brief, e.g. https://<your-dashboard>/observability/brief
BRIEF_LIVE_URL=
# A secret that lets a wall display open the screen-mode page without logging
# in (?token=...). Leave blank to require a dashboard login for it.
BRIEF_SCREEN_TOKEN=
# The Python interpreter that runs the renderer (a venv path, say).
BRIEF_PYTHON=python3

# --- ENABLES: Observe — the coach's assistant (/observe) ---------------------
# For the people who visit classrooms to coach teachers. A coach records a
# lesson and sends it; Rumi pre-fills the observation ratings, the coach edits
# them in chat, gets a guide for the feedback conversation, records that
# conversation and is coached on it; the teacher receives a warm report (never
# a score). Works on every channel — the edit form is stepwise chat everywhere,
# and a WhatsApp Flow on Meta when OBSERVE_FORM_FLOW_ID is set.
# Who is a coach: users.role (see docs/features/observe.md for the roster
# script). Set OBSERVE_ENABLED=true to turn it on — on the bot AND on the
# dashboard service (the portal's coach view reads its own environment and
# stays off without it).
# With LP_FIDELITY_ENABLED=true as well, observations get Section B (did the
# lesson follow its plan?): the coach links the teacher's plan and reviews each
# move's verdict. See docs/features/observe.md#section-b--did-the-lesson-follow-its-plan
OBSERVE_ENABLED=
# Roles that may use /observe (comma list). Default: head_teacher,principal,school_leader,coach,supervisor
# (principal and school_leader are read as aliases of head_teacher; the roster script writes head_teacher).
OBSERVE_LEADER_ROLES=
# Of those, the roles who also teach and may send their OWN lesson for
# self-coaching. Default: head_teacher,principal,school_leader
OBSERVE_SELF_COACH_ROLES=
# Observation framework: teach (default — the public TEACH tool), hots, mewaka.
OBSERVE_FRAMEWORK=teach
# Meta only: the published editable-form WhatsApp Flow ("Observe Form" in rumi setup;
# JSON from bot/scripts/generate-observe-flow-json.js — regenerate it for hots/mewaka).
# Blank = stepwise chat form.
OBSERVE_FORM_FLOW_ID=
# Namespace for school ids when one database serves several school registers
# (e.g. "district-a:"). Blank = ids as imported.
OBSERVE_SCHOOL_ID_PREFIX=
# Label stored on roster rows written by the roster script (e.g. import, manual).
OBSERVE_ROSTER_SOURCE=manual
# Report delivery review gate: blank = reports go straight to the teacher;
# "operator" = every report goes to OBSERVE_REVIEW_NUMBER first (a pilot check).
OBSERVE_REVIEW_MODE=
OBSERVE_REVIEW_NUMBER=
# Meta only: approved template that invites a teacher outside the 24-hour
# window (other channels have no window and send directly).
OBSERVE_REPORT_TEMPLATE=
OBSERVE_REPORT_TEMPLATE_LANG=en
# Background sweeps: set to "true" to switch one off. The debrief retry runs
# in the coaching worker every 15 minutes; the two report sweeps run in the
# stale-session worker (untapped = a report invite the teacher never tapped,
# Meta only; undelivered = a finished observation whose report the coach
# never sent).
OBSERVE_DEBRIEF_RETRY_OFF=
OBSERVE_UNDELIVERED_SWEEP_OFF=
OBSERVE_UNTAPPED_SWEEP_OFF=
# Sweep tuning (blank = defaults). Untapped: one nudge a day after the invite,
# give up two days later; an invite nobody chased that is older than
# OBSERVE_UNTAPPED_EXPIRE_DAYS (default 7) is closed silently. Undelivered:
# remind the coach after OBSERVE_UNDELIVERED_REMIND_HOURS (24), give up at
# OBSERVE_UNDELIVERED_GIVE_UP_HOURS (72), close unchased rows silently after
# OBSERVE_UNDELIVERED_EXPIRE_HOURS (168). Per-tick caps default to 25.
OBSERVE_UNTAPPED_EXPIRE_DAYS=
OBSERVE_UNTAPPED_MAX_PER_TICK=
OBSERVE_UNDELIVERED_REMIND_HOURS=
OBSERVE_UNDELIVERED_GIVE_UP_HOURS=
OBSERVE_UNDELIVERED_EXPIRE_HOURS=
OBSERVE_UNDELIVERED_MAX_PER_TICK=
# School days offered when a coach plans a visit, as ISO weekdays (1 = Monday …
# 7 = Sunday). Blank = Monday to Friday.
OBSERVE_SCHOOL_DAYS=
# Optional calendar invites for scheduled visits (Google Calendar, off by
# default). Scheduling works without it; a calendar outage never blocks it.
OBSERVE_CALENDAR_ENABLED=
OBSERVE_CALENDAR_TIMEZONE=UTC
# Service-account key JSON (inline) for the calendar provider, and the calendar to write to.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_CALENDAR_ID=
# Optional: the workspace user the service account acts as (domain-wide
# delegation) — needed for the invite to reach the coach as an attendee.
GOOGLE_CALENDAR_SUBJECT=

# --- ENABLES: Teacher nudges (scheduled check-ins with quiet teachers) ------
# A short, friendly message to a teacher who has gone quiet ("Planning anything
# for your next class?"), at most once per quiet spell, sent on whichever
# channel they last used. Off until TEACHER_NUDGES_ENABLED is on. The SQS
# worker then sweeps on an interval; or schedule
# `node bot/workers/teacher-nudges.worker.js` from cron instead.
# On the Meta WhatsApp Cloud driver, nudges only go out inside the 24-hour
# customer-service window. See docs/features/teacher-nudges.md.

# The master switch: true / 1 / yes = on. Anything else (or blank) = off.
TEACHER_NUDGES_ENABLED=
# Minutes between sweeps on the SQS worker (fractions allowed, e.g. 0.5).
TEACHER_NUDGES_SWEEP_MINUTES=5
# The most nudges one sweep claims, across every nudge kind.
TEACHER_NUDGES_MAX_PER_TICK=200
# The time zone (IANA name) the "one per day" rule and quiet hours are judged in.
# Blank = ATTENDANCE_TZ (the school's clock), else UTC.
TEACHER_NUDGES_TZ=
# Local hours with no nudges, start-end (21-7 = 21:00 to 06:59). Blank = none.
TEACHER_NUDGES_QUIET_HOURS=21-7
# How long a teacher must have been silent before a check-in (1200 = 20 hours).
TEACHER_NUDGES_QUIET_MINUTES=1200
# Silences that began longer ago than this many days are left alone.
TEACHER_NUDGES_LOOKBACK_DAYS=14

# --- ENABLES: Lesson quiz (a quiz from the lesson just taught or planned) ----
# After a coaching report Rumi offers a quiz on that lesson; /quiz lists recent
# lessons, lesson plans and a "quiz on any topic". The teacher gets a one-page
# PDF and one message to forward to the class; children answer in their own
# chat; a class report follows next morning. Writes with OPENROUTER_API_KEY.
# Guide: docs/features/lesson-quiz.md
TRANSCRIPT_QUIZ_ENABLED=
# The school's time zone (IANA name): the report time, quiet hours, lesson
# dates and "today" for the daily cap are all judged in it.
SCHOOL_TIMEZONE=UTC
# No quiz messages to teachers in this window (local hours, start-end), or off.
QUIET_HOURS=21-7
# Quiz languages, comma-separated (en, ur, ...). More than one makes Rumi ask
# which; copy falls back to English for a language with no catalogue.
QUIZ_LANGUAGES=en
# Subjects whose quiz language is fixed, as subject:code pairs (e.g. urdu:ur).
QUIZ_SUBJECT_LANGUAGE=
# Offer after every coaching report ("every") or only the first ("once").
TRANSCRIPT_QUIZ_OFFER_MODE=once
# Only offer for these subjects (comma-separated); blank means every subject.
TRANSCRIPT_QUIZ_SUBJECTS=
# Models for the author, the blind answer-key check and the report's reteach
# box. Leave blank to use each job's default in the model registry
# (bot/shared/config/model-registry.js): an OpenRouter id on OpenRouter, an
# OpenAI id under LLM_PROVIDER=openai. A value that is not a model id is
# ignored; under LLM_PROVIDER=openai an OpenRouter id of another vendor falls
# back to the job's OpenAI default.
TRANSCRIPT_QUIZ_MODEL=
TRANSCRIPT_QUIZ_VERIFY_MODEL=
QUIZ_REPORT_MODEL=
# Authoring attempts per quiz before the teacher is told it could not be made.
TRANSCRIPT_QUIZ_MAX_ATTEMPTS=3
# Minutes a quiz may sit in "being made" with no sign of life before it counts
# as stuck: a second generate run may take it over, and /quiz offers to make it
# again. Default 30, the generate job's queue lease.
TRANSCRIPT_QUIZ_STALE_MINUTES=30
# Most quizzes one teacher can make per school day (off or 0 = no cap).
QUIZ_DAILY_CAP=10
# "Select all that apply" questions (children reply with every right letter,
# e.g. "A C"). On unless set to off.
QUIZ_ALLOW_MULTI=
# Check that the teacher sheet's summary lines are true of the subject (on unless off).
QUIZ_SUMMARY_TRUTH_FILTER=
# Urdu line spacing on cards and PDFs (on unless off).
QUIZ_URDU_SPACING_V2=
# One nudge to the teacher when fewer than N children started after M minutes.
TRANSCRIPT_QUIZ_NUDGE_BELOW=5
TRANSCRIPT_QUIZ_NUDGE_AFTER_MINUTES=360
# Share links: on Matrix, the bot's account (@rumi:your.server) for a matrix.to
# link; on WhatsApp the link uses WHATSAPP_BOT_NUMBER. Without either the class
# message carries the join code alone.
MATRIX_USER_ID=
# After the class report, send each child a card of the class's results (true/false).
CLASS_CARD_ENABLED=
# A second report when late answers arrive after the scheduled one (on/off).
VIDEO_REPORT_SCHEDULED_FOLLOWUP=
# /quiz menu switches, each on unless set to off: every bare "quiz" opens the
# menu; a quiz question waiting on the phone keeps the reply in the quiz;
# lesson plans with no quiz yet are listed and made on a tap; each row names
# its source ("From lesson plan" / "From transcript").
QUIZ_BARE_TEXT_TO_MENU=
QUIZ_MENU_HANDSET_ROUTING=
QUIZ_MENU_LESSON_ROWS=
QUIZ_MENU_SOURCE_LABELS=
# Seconds one phone is locked to one join code (default 60; a test lane shortens it).
VIDEO_QUIZ_JOIN_LOCK_SECS=
# Outbound quiz sends per second across the process (default 40).
OUTBOUND_MAX_MPS=

# --- LLM: advanced (optional) -----------------------------------------------

# LLM provider: 'openrouter' (default, recommended) or 'openai' (direct)
LLM_PROVIDER=openrouter

# Direct OpenAI API key — only needed if LLM_PROVIDER=openai
OPENAI_API_KEY=

# Override the default model (default: openai/gpt-4o via OpenRouter)
LLM_MODEL=openai/gpt-4o

# App URL used for OpenRouter's HTTP-Referer header (optional)
APP_URL=https://your-app.up.railway.app

# --- Region (optional) -------------------------------------------------------
# This deployment's region. Per-region behaviour (which LP paths, coaching
# framework, languages) is driven by the region_features DB table — set a row
# per region; no code changes needed. Leave as 'default' for the generic setup.
DEFAULT_REGION=default

# Default observation framework shown in the settings flow (oecd|hots|teach|fico).
DEFAULT_OBSERVATION_FRAMEWORK=oecd
# Optional per-region framework overrides as a JSON object, e.g.
# REGION_FRAMEWORK_MAP={"punjab":"hots","india":"teach"}. Unset regions use the default above.
REGION_FRAMEWORK_MAP=
# Optional override for the settings language dropdown — JSON array of
# {"id","title"} objects. Unset uses the built-in multilingual default list.
# India example (union of markets):
# SETTINGS_LANGUAGES=[{"id":"en","title":"English"},{"id":"hi","title":"हिन्दी (Hindi)"},{"id":"bn","title":"বাংলা (Bengali)"},{"id":"mr","title":"मराठी (Marathi)"},{"id":"te","title":"తెలుగు (Telugu)"},{"id":"ta-IN","title":"தமிழ் (Tamil)"},{"id":"kn","title":"ಕನ್ನಡ (Kannada)"}]
# Francophone example:
# SETTINGS_LANGUAGES=[{"id":"en","title":"English"},{"id":"fr","title":"Français (French)"}]
SETTINGS_LANGUAGES=

# --- ENABLES: Voice notes in (transcription) — Soniox -----------------------
# Set this to let teachers send voice notes the bot understands (multi-language
# STT: Urdu, Balochi, Sindhi, Pashto, ...). Also required for reading assessment
# and coaching, which both consume audio. Get a key at https://soniox.com
SONIOX_API_KEY=

# --- ENABLES: Spoken replies (text-to-speech) — ElevenLabs ------------------
# Set this to let the bot reply with voice. Get a key at https://elevenlabs.io
ELEVENLABS_API_KEY=
# Default English voice ID (a sensible default is provided)
ELEVENLABS_VOICE_ID=cgSgspJ2msm6clMCkdW9
# Additional-language voice IDs (optional — defaults exist)
# ELEVENLABS_VOICE_ID_ES=your-spanish-voice-id
# ELEVENLABS_VOICE_ID_AR=your-arabic-voice-id
# India-market voice IDs (optional — default to the shared multilingual voice).
# Set a native-verified voice per language before an India launch. Kannada,
# Marathi, Telugu and Bengali especially should be listen-tested (else OpenAI
# tts-1 is the automatic fallback).
